@model QuanLyMonAn_BIT242902.Models.Dish_BIT242902

@{
    ViewData["Title"] = "Thêm món ăn mới";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4 text-success fw-bold">THÊM MÓN ĂN MỚI</h2>

    <form asp-action="Create" method="post" class="shadow p-4 rounded bg-light">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Tên món ăn</label>
            <input asp-for="Name" class="form-control" placeholder="Nhập tên món ăn..." />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Loại món ăn</label>
            <select asp-for="DishCategoryId" class="form-select" asp-items="ViewBag.DishCategoryId">
                <option value="">-- Chọn loại món --</option>
            </select>
            <span asp-validation-for="DishCategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label fw-bold">Giá (VNĐ)</label>
            <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="Nhập giá..." />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PreparationTime" class="form-label fw-bold">Thời gian chế biến (phút)</label>
            <input asp-for="PreparationTime" type="number" class="form-control" placeholder="Số phút chế biến..." />
            <span asp-validation-for="PreparationTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Đường dẫn ảnh (ImageUrl)</label>
            <input type="text" name="imageUrl" class="form-control" placeholder="https://... hoặc /images/ten-anh.jpg" />
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsAvailable" class="form-check-input" checked />
            <label asp-for="IsAvailable" class="form-check-label fw-bold">Đang bán (Available)</label>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-success fw-bold">Lưu món ăn</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </form>
</div>